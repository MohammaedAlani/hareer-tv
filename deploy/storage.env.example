# Copy to .private/storage.env, fill privately, and create a Kubernetes Secret.
S3_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=YOUR_HAREER_BUCKET
S3_ACCESS_KEY_ID=REPLACE_PRIVATELY
S3_SECRET_ACCESS_KEY=REPLACE_PRIVATELY
PUBLIC_BASE_URL=https://tv.nawaa.app
